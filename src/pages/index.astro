        </div>
        <a class="link" href="/blog/">Read all posts</a>
      </div>
      <div class="grid">
        {posts.map((post) => {
          const iconName = postIconMap[post.id] ?? 'rust';
          return (
            <a class="card card--row span-6" href={`/blog/${post.id}/`}>
              <span class="post-card-meta">{formatDate(post.data.pubDate)} · {post.data.readingTime}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="panel panel--flush">
                <div class="blog-preview-box">
                  <div class="blog-preview-tags">
                    {post.data.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                  <span class="ic-tile">
                    <img class={`ic ic-28 ${iconName === 'rust' ? 'ic-ink' : ''}`} src={`/assets/icons/${iconName}.svg`} alt="" width="28" height="28" loading="lazy">
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
