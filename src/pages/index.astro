---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS, PROFILE } from '../data/projects';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredPostIds = ['gitops-pipeline-for-go-service', 'rust-audio-thread-thunder'];
const posts = [
  ...featuredPostIds
    .map((id) => allPosts.find((p) => p.id === id))
    .filter((p): p is (typeof allPosts)[number] => Boolean(p)),
  ...allPosts.filter((p) => !featuredPostIds.includes(p.id)),
].slice(0, 2);

const bySlug = Object.fromEntries(PROJECTS.map((p) => [p.slug, p]));
const shippedCount = PROJECTS.filter((p) => p.status === 'Shipped').length;
const showcaseCount = PROJECTS.filter((p) => p.status === 'Showcase').length;
const hobbyCount = PROJECTS.filter((p) => p.status === 'Hobby').length;

const stackDiagram = JSON.stringify({
  layout: 'hub',
  alt: 'Deniz Dayan builds with Spring Boot, TypeScript, Next.js, PostgreSQL, Redis, Docker, GitHub Actions, and Kubernetes.',
  motion: { pulse: 'none' },
  center: { label: 'cotanjant', icon: 'ui:terminal' },
  spokes: [
    { label: 'Spring Boot', icon: 'spring' },
    { label: 'TypeScript', icon: 'typescript' },
    { label: 'Next.js', icon: 'nextjs' },
    { label: 'PostgreSQL', icon: 'postgres' },
    { label: 'Redis', icon: 'redis' },
    { label: 'Docker', icon: 'docker' },
    { label: 'GitHub Actions', icon: 'github-actions' },
    { label: 'Kubernetes', icon: 'kubernetes' },
  ],
});

const postIconMap: Record<string, string> = {
  'rust-audio-thread-thunder': 'rust',
  'booting-krnl-with-limine': 'linux-tux',
  'gitops-pipeline-for-go-service': 'kubernetes',
};

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---
<BaseLayout
  title="cotanjant: Software by Deniz Dayan"
  description="Personal website of Deniz Dayan (cotanjant): Java and Spring Boot backends, TypeScript full-stack web apps, DevOps pipelines, and hobby projects."
  canonicalPath="/"
  activeNav="home"
  hasMoment={true}
>
  <Fragment slot="head">
    <style is:inline>
      .hero--triptych .hero__cta .btn {
        height: var(--btn-h);
        font-size: var(--t-body);
      }
      .ly-collage { container-type: inline-size; }
      .ly-collage .ly-piece {
        border: 1px solid color-mix(in oklab, var(--ink) 14%, transparent);
        background: var(--surface);
        color: var(--ink);
        padding: 3.2cqw;
        display: grid;
        align-content: start;
        gap: 1.6cqw;
        font: 400 max(13px, 1.9cqw)/1.35 var(--font-text);
      }
      .pc-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5cqw;
        font: 500 max(13px, 1.6cqw)/1.2 var(--font-mono);
        color: var(--muted);
      }
      .pc-title {
        font: 500 max(16px, 3.2cqw)/1.12 var(--font-display);
        letter-spacing: -0.02em;
        margin: 0;
        color: var(--ink);
      }
      .pc-rows {
        display: grid;
        gap: 1.1cqw;
        border-top: 1px solid color-mix(in oklab, var(--ink) 12%, transparent);
        padding-top: 1.4cqw;
      }
      .pc-row {
        display: flex;
        justify-content: space-between;
        gap: 1.5cqw;
        font: 400 max(13px, 1.6cqw)/1.3 var(--font-mono);
      }
      .pc-row em {
        font-style: normal;
        color: var(--accent);
      }
      .pc-card-bottom {
        padding-bottom: 7cqw;
      }
      .pc-badge {
        display: inline-block;
        padding: 2px 7px;
        border-radius: var(--r-sm);
        background: var(--bg);
        color: var(--accent);
        font: 500 13px/1.2 var(--font-mono);
      }
      .pc-badge--hobby {
        color: var(--muted);
        border: 1px solid color-mix(in oklab, var(--ink) 14%, transparent);
      }
      @media (max-width: 639px) {
        .ly-collage .ly-piece {
          padding: var(--s-4);
        }
        .ly-collage .ly-piece:nth-child(1) {
          left: 0 !important; top: 0 !important; width: 100% !important; height: 47% !important;
        }
        .ly-collage .ly-piece:nth-child(2) {
          left: 0 !important; top: 51% !important; width: 100% !important; height: 49% !important;
          padding-bottom: var(--s-4);
        }
        .ly-collage .ly-piece:nth-child(n+3) {
          display: none;
        }
        .pc-rows .pc-row:nth-child(n+3) {
          display: none;
        }
      }

      /* app-frame (#projects) */
      .app.ui {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        margin-top: var(--s-7);
        background: var(--u-bg);
        border: 1px solid var(--u-border);
        border-radius: var(--u-r);
        box-shadow: var(--u-shadow);
      }
      .app > .app__pane {
        position: relative;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
      }
      .app > .app__pane + .app__pane {
        border-left: 1px solid var(--u-line);
      }
      .app > .app__pane > .ui-panel {
        width: 100%;
        border: 0;
        border-radius: 0;
        box-shadow: none;
      }
      .app > .app__pane::after {
        content: "";
        position: absolute;
        inset: auto 0 0 0;
        height: 48px;
        background: linear-gradient(transparent, var(--u-bg));
        pointer-events: none;
      }
      .ui-win__st.is-shipped {
        color: var(--u-accent-text);
        background: var(--u-tint);
        box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--u-accent) 24%, transparent);
      }
      .ui-win__st.is-shipped::before {
        background: currentColor;
        opacity: 1;
      }
      @media (min-width: 1024px) and (max-width: 1279px) {
        .app.ui { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
      }
      @media (max-width: 1023px) {
        .app.ui {
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: auto minmax(0, 1fr);
        }
        .app > .app__pane--list { max-height: 252px; }
        .app > .app__pane--list::after { display: none; }
        .app .ui-win__side { display: none; }
        .app .ui-win__body { grid-template-columns: minmax(0, 1fr); }
        .app > .app__pane + .app__pane { border-left: 0; border-top: 1px solid var(--u-line); }
      }
      @media (max-width: 639px) {
        .app.ui { grid-template-rows: minmax(0, 1fr); }
        .app > .app__pane--list { display: none; }
        .app > .app__pane + .app__pane { border-top: 0; }
      }

      /* tabs-tour (#builds) */
      .tabs-panels {
        margin-top: var(--s-5);
        min-height: 180px;
      }
      .tabs-panels [role="tabpanel"] p {
        margin: 0 0 var(--s-4);
        font-size: var(--t-lead);
        line-height: 1.5;
      }
      .tabs-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s-5);
      }
      #builds .frame--split {
        min-height: 440px;
      }
      #blog .panel { --p-h: 340px; }
      @media (max-width: 1023px) {
        #builds .frame--split { margin-top: var(--s-6); min-height: 360px; }
        #blog .panel { --p-h: 220px; }
        #about .frame--split { margin-top: var(--s-6); height: 320px; }
      }
      @media (max-width: 639px) {
        .tab { min-height: 44px; }
        .tabs-panels { min-height: 0; }
        #builds .frame--split { margin-top: var(--s-5); min-height: 260px; }
        #blog .panel { --p-h: 72px; }
        #blog .card { padding: var(--s-4); }
        #about .frame--split { height: 180px; margin-top: var(--s-4); }
      }
      .about-facts {
        margin: var(--s-5) 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: var(--s-2);
        font-size: var(--t-small);
        color: var(--muted);
      }
      .about-facts li {
        padding-top: var(--s-2);
        border-top: 1px solid var(--line);
      }
      .about-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s-5);
        margin-top: var(--s-5);
      }
      .blog-preview-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s-4);
        padding: var(--s-5);
        height: 100%;
        background: var(--surface);
      }
      .blog-preview-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s-2);
        font: 500 var(--t-label)/1.2 var(--font-mono);
        color: var(--ink);
      }
      .blog-preview-tags span {
        padding: 4px 8px;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--r-sm);
      }
      .post-card-meta {
        font: 500 var(--t-label)/1.2 var(--font-mono);
        color: var(--muted);
      }
    </style>
  </Fragment>

  <section class="hero hero--triptych" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero-text grid hero__grid">
        <div class="span-3">
          <h1 id="hero-h">Software by Deniz Dayan</h1>
          <p class="hero__lead">Backend, full-stack, and DevOps projects in Java, TypeScript, and Docker, plus Rust hobby builds.</p>
        </div>

        <div class="ly-collage span-6 start-4" role="img" aria-label="Three rotating views of projects by Deniz Dayan: cartflame, teamalazfrc, showcase, ridvanotel, skallibrary, thunder, daily, and krnl.">
          <div class="ly-collage__set is-on">
            <div class="ly-piece" style="left: 4%; top: 6%; width: 47%">
              <div class="pc-head"><span>cartflame</span><span class="pc-badge">Showcase</span></div>
              <p class="pc-title">Spring Boot API</p>
              <div class="pc-rows">
                <div class="pc-row"><span>Data</span><em>Postgres</em></div>
                <div class="pc-row"><span>Cache</span><em>Redis</em></div>
                <div class="pc-row"><span>Queue</span><em>RabbitMQ</em></div>
              </div>
            </div>
            <div class="ly-piece pc-card-bottom" style="left: 49%; top: 46%; width: 47%; height: 50%">
              <div class="pc-head"><span>teamalazfrc</span><span class="pc-badge">Shipped</span></div>
              <p class="pc-title">Team ALAZ #12368</p>
              <div class="pc-rows">
                <div class="pc-row"><span>Stack</span><em>Next.js 15</em></div>
                <div class="pc-row"><span>Admin</span><em>Git CMS</em></div>
                <div class="pc-row"><span>Auth</span><em>HMAC</em></div>
              </div>
            </div>
            <div class="ly-piece" style="left: 53%; top: 10%; width: 43%">
              <div class="pc-head"><span>showcase</span><span class="pc-badge">DevOps</span></div>
              <p class="pc-title">GitOps pipeline</p>
              <div class="pc-rows">
                <div class="pc-row"><span>Sync</span><em>ArgoCD</em></div>
                <div class="pc-row"><span>Infra</span><em>OpenTofu</em></div>
              </div>
            </div>
          </div>

          <div class="ly-collage__set" aria-hidden="true">
            <div class="ly-piece" style="left: 4%; top: 6%; width: 47%">
              <div class="pc-head"><span>ridvanotel</span><span class="pc-badge">Shipped</span></div>
              <p class="pc-title">Ridvan Otel Cesme</p>
              <div class="pc-rows">
                <div class="pc-row"><span>Locales</span><em>TR / EN</em></div>
                <div class="pc-row"><span>Stack</span><em>React + Vite</em></div>
                <div class="pc-row"><span>Motion</span><em>GSAP</em></div>
              </div>
            </div>
            <div class="ly-piece pc-card-bottom" style="left: 49%; top: 46%; width: 47%; height: 50%">
              <div class="pc-head"><span>skallibrary</span><span class="pc-badge">Shipped</span></div>
              <p class="pc-title">SKAL catalog</p>
              <div class="pc-rows">
                <div class="pc-row"><span>Stack</span><em>Django</em></div>
                <div class="pc-row"><span>Loans</span><em>14-day</em></div>
                <div class="pc-row"><span>Guard</span><em>PROTECT</em></div>
              </div>
            </div>
            <div class="ly-piece" style="left: 53%; top: 10%; width: 43%">
              <div class="pc-head"><span>cartflame</span><span class="pc-badge">Docker</span></div>
              <p class="pc-title">Local stack</p>
              <div class="pc-rows">
                <div class="pc-row"><span>Compose</span><em>4 services</em></div>
                <div class="pc-row"><span>Broker</span><em>RabbitMQ</em></div>
              </div>
            </div>
          </div>

          <div class="ly-collage__set" aria-hidden="true">
            <div class="ly-piece" style="left: 4%; top: 6%; width: 47%">
              <div class="pc-head"><span>thunder</span><span class="pc-badge pc-badge--hobby">Hobby</span></div>
              <p class="pc-title">Step-sequencer DAW</p>
              <div class="pc-rows">
                <div class="pc-row"><span>Audio</span><em>cpal</em></div>
                <div class="pc-row"><span>UI</span><em>egui_dock</em></div>
                <div class="pc-row"><span>Plugins</span><em>CLAP</em></div>
              </div>
            </div>
            <div class="ly-piece pc-card-bottom" style="left: 49%; top: 46%; width: 47%; height: 50%">
              <div class="pc-head"><span>daily</span><span class="pc-badge pc-badge--hobby">Hobby</span></div>
              <p class="pc-title">Rust CLI tools</p>
              <div class="pc-rows">
                <div class="pc-row"><span>download</span><em>progress</em></div>
                <div class="pc-row"><span>remind</span><em>picker</em></div>
              </div>
            </div>
            <div class="ly-piece" style="left: 53%; top: 10%; width: 43%">
              <div class="pc-head"><span>krnl</span><span class="pc-badge pc-badge--hobby">Hobby</span></div>
              <p class="pc-title">Limine kernel</p>
              <div class="pc-rows">
                <div class="pc-row"><span>Target</span><em>x86_64</em></div>
                <div class="pc-row"><span>Boot</span><em>QEMU</em></div>
              </div>
            </div>
          </div>
        </div>

        <div class="span-3 start-10 hero__cta">
          <a class="btn btn--primary" href="#projects">See projects<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-h">
    <div class="wrap">
      <div class="grid">
        <div class="span-5">
          <h2 id="projects-h">GitHub projects</h2>
        </div>
        <div class="span-6 start-7">
          <p class="t-lead">Spring Boot backend services, shipped TypeScript and Django web apps, Kubernetes GitOps pipelines, and Rust hobby projects.</p>
          <p><a class="link" href={PROFILE.github} target="_blank" rel="noopener">Browse all {PROFILE.repoCount} repositories</a></p>
        </div>
      </div>

      <div class="ui app fill" role="img" aria-label="Repository list for cotanjant beside the cartflame Spring Boot backend test runner" data-ui-pause-host>
        <div class="app__pane app__pane--list">
          <div class="ui ui-panel ui-win" data-ui="window">
            <div class="ui-win__bar">
              <span class="ui-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="ui-win__crumb">cotanjant <i>/</i> <b>repositories</b></span>
              <span class="ui-spacer"></span>
              <span class="ui-win__search" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 3 3"/></svg><span class="ui-win__ph">Filter</span><span class="ui-kbd">/</span></span>
            </div>
            <div class="ui-win__body">
              <nav class="ui-win__side" aria-hidden="true">
                <span class="ui-win__nav is-on">Selected<em>{PROJECTS.length}</em></span>
                <span class="ui-win__nav">Shipped<em>{shippedCount}</em></span>
                <span class="ui-win__nav">Showcase<em>{showcaseCount}</em></span>
                <span class="ui-win__nav">Hobby<em>{hobbyCount}</em></span>
                <span class="ui-win__label">Areas</span>
                <span class="ui-win__nav"><span class="ui-win__hash">#</span>backend</span>
                <span class="ui-win__nav"><span class="ui-win__hash">#</span>web</span>
                <span class="ui-win__nav"><span class="ui-win__hash">#</span>devops</span>
                <span class="ui-win__nav"><span class="ui-win__hash">#</span>hobby</span>
              </nav>
              <div class="ui-win__main">
                <div class="ui-win__cols" aria-hidden="true"><span>Repo</span><span>Area</span><span>State</span><span>Lang</span></div>
                <ul class="ui-win__rows">
                  {PROJECTS.map((repo, idx) => (
                    <li class="ui-win__row" data-row>
                      <span class="ui-avatar" data-tone={String((idx % 5) + 1)}>{repo.name.slice(0, 2).toUpperCase()}</span>
                      <span class="ui-win__who">{repo.name}</span>
                      <span class="ui-win__sub">{repo.category}</span>
                      <span class={`ui-win__st ${repo.status === 'Shipped' ? 'is-shipped' : repo.status === 'Showcase' ? 'is-you' : 'is-done'}`} data-st>{repo.status}</span>
                      <span class="ui-win__age">{repo.shortLang}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="app__pane app__pane--open" data-ui-loop>
          <div class="ui ui-panel ui-term" data-ui="terminal-run">
            <div class="ui-term__head">
              <span class="ui-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="ui-term__title">cartflame</span>
              <span class="ui-meta">java / spring</span>
              <span class="ui-spacer"></span>
              <span class="ui-chip ui-chip--plain ui-term__branch"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="3.5" r="1.5"/><circle cx="5" cy="12.5" r="1.5"/><circle cx="11" cy="5.5" r="1.5"/><path d="M5 5v6M11 7c0 2.6-6 1.8-6 4"/></svg>main</span>
            </div>
            <div class="ui-term__screen" data-term-screen>
              <div class="ui-term__track" data-term-track>
                <div class="ui-term__ln ui-term__cmd"><span class="ui-term__cwd">~/src/<span class="ui-term__up">cotanjant/</span>cartflame</span><span class="ui-term__sig">$</span><span class="ui-term__typed" data-term-cmd>docker compose up -d && ./mvnw test</span></div>
                <div class="ui-term__ln ui-term__meter" data-term-out data-term-meter><span class="ui-term__bar" style="--p:1"><i></i></span><span class="ui-term__count" data-term-count>4 of 4 suites</span></div>
                <div class="ui-term__ln ui-term__log" data-term-out data-term-step><svg class="ui-term__tick" viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 8.4 2.8 2.8 6.2-6.4"/></svg><span class="ui-term__path">postgres::schema</span><span class="ui-term__n">db</span><span class="ui-term__t">210ms</span></div>
                <div class="ui-term__ln ui-term__log" data-term-out data-term-step><svg class="ui-term__tick" viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 8.4 2.8 2.8 6.2-6.4"/></svg><span class="ui-term__path">redis::rate_limit</span><span class="ui-term__n">cache</span><span class="ui-term__t">145ms</span></div>
                <div class="ui-term__ln ui-term__log" data-term-out data-term-step><svg class="ui-term__tick" viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 8.4 2.8 2.8 6.2-6.4"/></svg><span class="ui-term__path">rabbitmq::events</span><span class="ui-term__n">mq</span><span class="ui-term__t">320ms</span></div>
                <div class="ui-term__ln ui-term__log" data-term-out data-term-step><svg class="ui-term__tick" viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 8.4 2.8 2.8 6.2-6.4"/></svg><span class="ui-term__path">api::checkout</span><span class="ui-term__n">http</span><span class="ui-term__t">480ms</span></div>
                <div class="ui-term__ln ui-term__gap" data-term-out aria-hidden="true"></div>
                <div class="ui-term__ln ui-term__sum" data-term-out><span class="ui-term__key">Stack</span><span class="ui-term__val">Spring Boot + Docker</span></div>
                <div class="ui-term__ln ui-term__sum" data-term-out><span class="ui-term__key">Mode</span><span class="ui-term__val">working showcase</span><span class="ui-term__dim">(local compose)</span></div>
                <div class="ui-term__ln ui-term__done" data-term-out data-term-done><span class="ui-term__ok"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 8.3 2.4 2.4 4.6-5"/></svg></span><b>Done</b><span class="ui-term__dim">in 1.16s</span></div>
                <div class="ui-term__ln ui-term__cmd" data-term-next><span class="ui-term__cwd">~/src/<span class="ui-term__up">cotanjant/</span>cartflame</span><span class="ui-term__sig">$</span><span class="ui-term__typed"></span><i class="ui-term__caret" aria-hidden="true"></i></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="builds" aria-labelledby="builds-h">
    <div class="wrap">
      <div class="grid">
        <div class="span-5">
          <div class="section-head">
            <h2 id="builds-h">Builds: backend, full-stack, DevOps, hobby. <span class="muted">Select a project to inspect its setup.</span></h2>
          </div>

          <div class="tabs" role="tablist" aria-label="Featured builds">
            <button class="tab" type="button" role="tab" id="t-cartflame" aria-selected="true" aria-controls="panel-cartflame screen-cartflame">Run cartflame</button>
            <button class="tab" type="button" role="tab" id="t-alaz" aria-selected="false" aria-controls="panel-alaz screen-alaz">Edit teamalazfrc</button>
            <button class="tab" type="button" role="tab" id="t-showcase" aria-selected="false" aria-controls="panel-showcase screen-showcase">Deploy showcase</button>
