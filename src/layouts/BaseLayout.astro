---
import { PROJECTS, PROFILE } from '../data/projects';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  activeNav?: 'home' | 'blog';
  hasMoment?: boolean;
}

const {
  title,
  description,
  canonicalPath = '/',
  activeNav = 'home',
  hasMoment = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://cotanjant.github.io').toString();
const isHome = activeNav === 'home';
const projectHref = isHome ? '#projects' : '/#projects';
const buildsHref = isHome ? '#builds' : '/#builds';
const aboutHref = isHome ? '#about' : '/#about';
const blogHref = '/blog/';
const topHref = isHome ? '#top' : '/';
const featuredNav = PROJECTS.slice(0, 6);
const latestProject = PROJECTS[0];
---
<!doctype html>
<html lang="en" data-type="software" data-radius="sharp" data-ground="sage" data-buttons="arrow" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta name="twitter:card" content="summary">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#161c1a">
<link rel="canonical" href={canonicalUrl}>
<meta name="site-kind" content="software">
<meta name="page-type" content="software">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<link rel="stylesheet" href="/assets/ui/base.css">
<link rel="stylesheet" href="/assets/ui/window/fragment.css">
<link rel="stylesheet" href="/assets/ui/terminal-run/fragment.css">
<link rel="stylesheet" href="/assets/ui/code/fragment.css">
<link rel="stylesheet" href="/assets/ui/pipeline-board/fragment.css">
<link rel="stylesheet" href="/assets/diagrams/diagram.css">
<style is:inline>
:root {
  --p-bg: #161c1a; --p-surface: #1f2725; --p-ink: #e3e2da; --p-muted: #8e948d;
  --p-accent: #9fc7b8; --p-accent-ink: #161c1a; --p-action: #9fc7b8; --p-action-ink: #161c1a;
  --p-inv-bg: #e3e2da; --p-inv-surface: #d3d2cb; --p-inv-ink: #161c1a; --p-inv-muted: #555a55;
  --p-inv-accent: #161c1a; --p-inv-accent-ink: #e3e2da; --p-inv-action: #161c1a; --p-inv-action-ink: #e3e2da;
  --font-display: "Geist", system-ui, sans-serif;
  --font-text: "Geist", system-ui, sans-serif;
  --font-mono: "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --display-weight: 500;
  --display-tracking: -0.035em;
  --display-tracking-xl: -0.045em;
}
.close__word { line-height: 1.02; }
@media (max-width: 639px) {
  .footer--dark .closing__links { gap: var(--s-4); }
  .footer--dark .closing__links .grid { gap: var(--s-3); }
  .footer--dark .closing__cta { gap: var(--s-3); }
  .close__word { font-size: clamp(42px, 15vw, 72px); }
}
</style>
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script is:inline src="/assets/backgrounds/backgrounds.js"></script>
{hasMoment && (
  <Fragment>
    <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
    <link rel="modulepreload" href="/assets/moments/moments.js">
    <link rel="modulepreload" href="/assets/moments/lib.js">
    <link rel="modulepreload" href="/assets/moments/word-highlight/moment.js">
  </Fragment>
)}
<slot name="head" />
</head>
<body>
<!-- type: software
     deal: hero triptych, nav nav-mega, close close-word, footer footer-dark, rhythm space, buttons arrow, mark stack, grounds bg-field (hero) + bg-halo (about)
     moments: word-highlight (statement) -->
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href={topHref}><span class="mark" data-mark="stack" aria-hidden="true"></span>{PROFILE.handle}</a>
    <nav class="nav__links" aria-label="Main">
      <div class="nav__item">
        <a class="nav__link" href={projectHref}>Projects <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            <div class="menu-col span-3">
              <p class="t-label">Systems</p>
              {featuredNav.slice(0, 3).map((p) => (
                <a href={p.repoUrl} target="_blank" rel="noopener">{p.name}<span>{p.category} in {p.language}</span></a>
              ))}
            </div>
            <div class="menu-col span-3">
              <p class="t-label">Tools and web</p>
              {featuredNav.slice(3, 6).map((p) => (
                <a href={p.repoUrl} target="_blank" rel="noopener">{p.name}<span>{p.category} in {p.language}</span></a>
              ))}
            </div>
            <a class="menu-card span-3 start-10" href={latestProject.repoUrl} target="_blank" rel="noopener">
              <div class="panel">
                <div class="stage stage--fade-br">
                  <div class="at-corner" style="--ax:24px;--ay:20px;--w:320px">
                    <div class="ui ui-panel ui-term" data-ui="terminal-run">
                      <div class="ui-term__head"><span class="ui-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="ui-term__title">thunder</span><span class="ui-meta">rust</span><span class="ui-spacer"></span></div>
                      <div class="ui-term__screen">
                        <div class="ui-term__ln ui-term__cmd"><span class="ui-term__sig">$</span><span>cargo run --release</span></div>
                        <div class="ui-term__ln ui-term__log"><span class="ui-term__path">cpal worker: 48 kHz</span><span class="ui-term__t">ready</span></div>
                        <div class="ui-term__ln ui-term__log"><span class="ui-term__path">clap scanner: isolated</span><span class="ui-term__t">ok</span></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <span class="t-card">{latestProject.name}</span>
              <span class="t-small muted">Step-sequencer DAW in Rust</span>
            </a>
          </div>
        </div>
      </div>
      <div class="nav__item"><a class="nav__link" href={buildsHref}>Builds</a></div>
      <div class="nav__item"><a class="nav__link" href={aboutHref}>About</a></div>
      <div class="nav__item"><a class="nav__link" href={blogHref} aria-current={activeNav === 'blog' ? 'page' : undefined}>Blog</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={projectHref}>See projects</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<main id="top">
  <slot />
</main>

<footer class="footer closing footer--dark ground-inverse g2m" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--word">
      <div class="section-head--split">
        <div>
          <h2 id="close-h">Read the source or write by email</h2>
          <p class="t-lead">Public repositories on GitHub, project notes in the blog, or direct email.</p>
        </div>
        <a class="btn btn--primary" href={projectHref}>See projects<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
      </div>
      <p class="close__word" aria-hidden="true">{PROFILE.handle}</p>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href={topHref}><span class="mark" data-mark="stack" aria-hidden="true"></span>{PROFILE.handle}</a>
          <p class="footer__lede">Systems, backends, and web software by {PROFILE.name}.</p>
        </div>
        <div class="span-2 footer__col">
          <h3>Projects</h3>
          <ul>
            <li><a href={PROJECTS[0].repoUrl} target="_blank" rel="noopener">thunder</a></li>
            <li><a href={PROJECTS[1].repoUrl} target="_blank" rel="noopener">krnl</a></li>
            <li><a href={PROJECTS[2].repoUrl} target="_blank" rel="noopener">showcase</a></li>
            <li><a href={PROJECTS[3].repoUrl} target="_blank" rel="noopener">teamalazfrc</a></li>
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>Tools</h3>
          <ul>
            <li><a href={PROJECTS[4].repoUrl} target="_blank" rel="noopener">daily</a></li>
            <li><a href={PROJECTS[6].repoUrl} target="_blank" rel="noopener">sp5der</a></li>
            <li><a href={PROJECTS[7].repoUrl} target="_blank" rel="noopener">fizz</a></li>
            <li><a href={PROJECTS[8].repoUrl} target="_blank" rel="noopener">cartflame</a></li>
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>Site</h3>
          <ul>
            <li><a href={projectHref}>Projects</a></li>
            <li><a href={aboutHref}>About</a></li>
            <li><a href={blogHref}>Blog</a></li>
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>Contact</h3>
          <ul>
            <li><a href={PROFILE.github} target="_blank" rel="noopener">GitHub</a></li>
            <li><a href={PROFILE.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href={`mailto:${PROFILE.email}`}>Email</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__legal">
        <span>&copy; 2026 {PROFILE.name} &nbsp; Product names and logos are trademarks of their owners.</span>
        <div class="socials"></div>
      </div>
    </div>
  </div>
</footer>

<script type="module" src="/assets/system.js"></script>
<script type="module" src="/assets/motion/motion.js"></script>
<script type="module" src="/assets/layout/layout.js"></script>
<script type="module" src="/assets/diagrams/mount.js"></script>
</body>
</html>
